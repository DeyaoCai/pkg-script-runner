{
  "name": "@pkg-runner/desktop-zones",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "桌面整理器：按类型归类移动 + 打开/重命名/回收站",
  "author": "DeyaoCai",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@pkg-runner/assets": "workspace:*",
    "@pkg-runner/controller": "workspace:*",
    "@pkg-runner/fonts": "workspace:*",
    "@pkg-runner/shell": "workspace:*",
    "@pkg-runner/tokens": "workspace:*",
    "@pkg-runner/ui": "workspace:*",
    "koffi": "^3.1.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "35.7.5",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  },
  "scripts": {
    "build:main": "node ./scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build:dev": "node ./scripts/build-main.mjs --dev",
    "build": "pnpm build:renderer && pnpm build:main",
    "dev:ui": "vite",
    "dev": "pnpm build:renderer && pnpm build:dev && electron .",
    "start": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist"
  }
}
