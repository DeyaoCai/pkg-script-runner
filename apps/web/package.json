{
  "name": "@pkg-runner/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pkg Runner Vue 3 renderer",
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1 --port 5200",
    "dev": "vite --host 127.0.0.1 --port 5200",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pkg-runner/controller": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "less": "^4.2.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
