{
  "name": "@pkg-runner/tray-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "DeyaoCai",
  "type": "module",
  "description": "Tray settings + screenshot history (Vue MPA)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5202",
    "dev:ui": "vite --host 127.0.0.1 --port 5202",
    "build": "pnpm --filter @pkg-runner/tokens build && pnpm --filter @pkg-runner/controller build && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "clean": "rimraf ../tray/dist-ui"
  },
  "dependencies": {
    "@pkg-runner/assets": "workspace:*",
    "@pkg-runner/controller": "workspace:*",
    "@pkg-runner/fonts": "workspace:*",
    "@pkg-runner/shell": "workspace:*",
    "@pkg-runner/tokens": "workspace:*",
    "@pkg-runner/ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "less": "^4.2.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
