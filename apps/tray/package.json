{
  "name": "@pkg-runner/tray",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Pkg Runner — tray + runner + screenshot (single process)",
  "author": "DeyaoCai",
  "main": "dist/main.js",
  "files": [
    "dist",
    "ui",
    "assets"
  ],
  "dependencies": {
    "@pkg-runner/assets": "workspace:*",
    "@pkg-runner/tokens": "workspace:*",
    "koffi": "^3.1.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build:main": "pnpm --filter @pkg-runner/assets build && pnpm --filter @pkg-runner/tokens build && node ./scripts/build-main.mjs",
    "build": "pnpm build:main",
    "build:dev": "pnpm --filter @pkg-runner/assets build && pnpm --filter @pkg-runner/tokens build && node ./scripts/build-main.mjs --dev",
    "dev": "node ./scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist release",
    "dist:win": "node ./scripts/dist-bundle.mjs",
    "dist:win:dir": "electron-builder --win dir --x64",
    "dist:win:nsis": "electron-builder --win nsis --x64"
  }
}
