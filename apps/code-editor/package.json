{
  "name": "@pkg-runner/code-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "轻量代码编辑器：WebStorm 式布局、多项目根、Git Diff 跳转",
  "author": "DS Agent",
  "main": "dist/main/main.js",
  "files": [
    "dist",
    "assets"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "@pkg-runner/controller": "workspace:*",
    "@pkg-runner/shell": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.0",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0",
    "node-pty": "^1.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  },
  "scripts": {
    "build:shell": "pnpm --filter @pkg-runner/shell build",
    "build:main": "pnpm build:shell && node ./scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "dev:ui": "vite",
    "dev": "pnpm build:main && node ./scripts/dev.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "pnpm build:shell && tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist release",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "dist:win": "pnpm build && electron-builder --win portable --x64",
    "install-context-menu": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-context-menu.ps1",
    "uninstall-context-menu": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-context-menu.ps1"
  }
}
